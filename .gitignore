# dependencies
node_modules/
*/node_modules/

# env / secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*credentials*

# build / runtime
dist/
*/dist/
.runtime/
*/.runtime/
.tmp/
*/.tmp/
.DS_Store

# generated demo artifacts / local state
artifacts/
*/artifacts/
RUNSTATE.md
*/RUNSTATE.md

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# raw recordings / intermediate media
*.mov
*.mkv
*raw*.mp4
*raw*.mp3
*sample*.mp3

# submission assets: ignore generated/intermediate assets by default; publish only selected final video
submission-assets/*
!submission-assets/presentation-video-2026-05-14-v2/
!submission-assets/presentation-video-2026-05-14-v2/Delegated-MindGames-Arena-Presentation-v2-2026-05-14.mp4

# generated dashboard data may include local artifact paths
mindgames-arena/web/data/*.json
!mindgames-arena/web/data/.gitkeep
GITHUB_UPLOAD_MANIFEST.txt
SECURITY_REVIEW.md
GITHUB_UPLOAD_CHECKLIST.md
