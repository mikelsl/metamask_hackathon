# Delegated MindGames Arena local config

# Telegram playable frontend
# Use a fresh BotFather bot for this MetaMask/1Shot submission. Do not reuse any previous hackathon bot.
METAMASK_TELEGRAM_BOT_TOKEN=
# Legacy fallback only; prefer METAMASK_TELEGRAM_BOT_TOKEN for this project.
TELEGRAM_BOT_TOKEN=

# LLM provider — not a judging focus for this hackathon; reuse an existing adapter/model.
# Direct Z.ai: LLM_BACKEND=zai, ZAI_API_KEY=..., ZAI_MODEL=glm-4.5
# OpenRouter fallback: LLM_BACKEND=openrouter-glm-speech, OPENROUTER_API_KEY=..., LLM_MODEL=z-ai/glm-4.5-air:free
LLM_BACKEND=openrouter-glm-speech
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-4.5-air:free
LLM_TEMPERATURE=0.95
LLM_MAX_TOKENS=420
LLM_MIN_REQUEST_INTERVAL_MS=0

# Multi-chain settlement vaults deployed with Cornerstone owner on 2026-05-13.
BASE_SEPOLIA_VAULT_ADDRESS=0x5677F20bD56538F20051Fe8Bf002e6D06780d85c
ARBITRUM_SEPOLIA_VAULT_ADDRESS=0x5677F20bD56538F20051Fe8Bf002e6D06780d85c
OPTIMISM_SEPOLIA_VAULT_ADDRESS=0x5677F20bD56538F20051Fe8Bf002e6D06780d85c

# Optional legacy EVM testnet path.
# 1Shot capabilities checked on 2026-05-13 did not include Mantle 5000/5003, so the primary 1Shot demo should use Base/Arbitrum/Optimism.
# mock = local only; mantle-sepolia = write game/action/finalization events on this legacy testnet path
MANTLE_BACKEND=mock
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY=
# Existing legacy testnet deployment (public addresses; safe to commit)
AGENT_REGISTRY_ADDRESS=0x4aDe976Ce967917d5263754f8F733B39151FE898
AGENT_ACTION_REGISTRY_ADDRESS=0xa432db727D908fFAEDEB51Aaec5A753357eb5704
GAME_SETTLEMENT_VAULT_ADDRESS=0xFbadd57084612223aA4D24eA61d7EBe7d470A35E
MANTLE_SEPOLIA_VAULT_ADDRESS=0xFbadd57084612223aA4D24eA61d7EBe7d470A35E
# Keep low while faucet balance is limited; 0 means record all actions
MANTLE_RECORD_ACTION_LIMIT=2

# Telegram performance bond UX — local/private env only; never commit real private keys.
TELEGRAM_WAGER_ENABLED=1
TELEGRAM_WAGER_DEFAULT_MODE=demo
TELEGRAM_WAGER_DEFAULT_CHAIN=arbitrum # arbitrum | mantle
TELEGRAM_WAGER_BOND_MNT=0.0001
TELEGRAM_WAGER_MIN_AGENT_GAS_MNT=0.0002
TELEGRAM_WAGER_AGENT_FUND_MNT=0.0005
# Optional safety allowlist for chats/users allowed to spend live demo wallets; comma-separated Telegram chat IDs/user IDs.
TELEGRAM_WAGER_ALLOWED_CHAT_IDS=
# Optional chain-specific operator keys. Arbitrum operator must own the Arbitrum vault; Mantle operator must own the legacy Mantle vault.
ARBITRUM_SEPOLIA_OPERATOR_PRIVATE_KEY=
MANTLE_SEPOLIA_OPERATOR_PRIVATE_KEY=
# Optional global fallback operator key.
TELEGRAM_WAGER_OPERATOR_PRIVATE_KEY=
# Comma-separated demo agent private keys, mapped to the default AI seats.
AGENT_WALLET_PRIVATE_KEYS=

# Local artifacts/dashboard
ARTIFACTS_DIR=./artifacts
UPDATE_LATEST_REPLAY=true
